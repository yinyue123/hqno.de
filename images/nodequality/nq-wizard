say()   { printf '%s\n' "$*"; }
head2() { printf '\n%s%s%s\n' "$B" "$*" "$D"; }
dim()   { printf '%s%s%s\n' "$DIM" "$*" "$D"; }

# The "name  →  value" line a spec row and a contact are both listed as, and
# both asked about before being deleted. Nothing for an index off the end.
pair() { jq -r "$1 // empty | \"\(.k)  →  \(.v)\"" "$SHOP" 2>/dev/null; }

# jq -r with a default, so a missing key never prints "null" at somebody.
q() { jq -r "$1 // \"\"" "$SHOP" 2>/dev/null; }

# A number typed at one of the lists, against the length of that list, into
# an index into the array — or nothing, for an answer that is not a line on
# the screen. Two used to get through and neither did what it looked like:
# `0` became the index -1, which in jq is the *last* item, so d0 deleted the
# plan at the far end of the list; and a number past the end wrote through
# `.rows[8] = …` on a list of two, which is jq for "pad it with six nulls"
# and the page will not render at all after that.
idx() {
	case "$1" in ""|*[!0-9]*) return 1 ;; esac
	[ "$1" -ge 1 ] && [ "$1" -le "$2" ] || return 1
	printf '%s' "$(($1 - 1))"
}

# The menu's own language decides which side of a {zh, en} pair is shown back.
# An English menu listing a plan as 入门 · 1C / 1 GB is telling a reader who
# asked for English that this is what their page says, which it is not.
first() { [ "$L" = en ] && printf 'en zh' || printf 'zh en'; }

# One line in, with a line editor behind it.
#
# `read` on its own has none: the terminal sends ^[[D for a left arrow and
# read puts those three characters in the variable, which is how a price
# being corrected became ¥49^[[D^[[D. -e hands the line to readline instead,
# and the arrows, home and end, backspace and delete, ^W for the last word
# and ^U for the line all arrive with it. readline counts characters rather
# than bytes, so the cursor lands where it looks like it will in a name
# written in Chinese.
#
# The prompt has to go through -p. Printed with printf first it is text
# readline never saw, so it counts the line from column 0 and the first
# backspace walks over the "> ". Colour inside a prompt has to be wrapped in
# \001 … \002 for the same reason — RDIM and RD below — or readline counts
# the escape sequence as the columns it does not take.
#
# readline writes to stderr, and that is the one thing that lets `ask` go on
# working inside x="$(ask …)": the prompt and the line being edited go to the
# terminal, and only the answer comes back down the pipe. With stdin not a
# terminal — `hqnode exec`, a pipe — bash ignores -e and this is the plain
# read it always was.
RDIM=$'\001\033[2m\002'; RD=$'\001\033[0m\002'
rl() { local __p="$1"; shift; IFS= read -e -r -p "$__p" "$@"; }

# Read one line with the current value shown, and keep the current value when
# the answer is empty. That rule is the whole editing model and it is stated
# on screen once rather than per field.
ask() {
	local prompt="$1" current="$2" reply
	# The prompt goes to stderr and only the answer to stdout, because every
	# caller is `x="$(ask …)"` — a prompt on stdout ends up *inside* the value
	# and gets written to shop.json, which is exactly what happened the first
	# time this was run.
	printf '%s\n' "  $prompt" >&2
	[ -n "$current" ] && printf '%s\n' "    ${DIM}$(m now)${D}${current}" >&2
	rl "    > " reply || reply=""
	[ -z "$reply" ] && { printf '%s' "$current"; return 0; }
	printf '%s' "$reply"
}

# Every write goes through here: jq to a temp file, then a rename, so an
# interrupted edit cannot leave shop.json half written. That file is the one
# thing in this container nobody else can reconstruct.
edit() {
	local filter="$1"; shift
	local tmp="$SHOP.tmp"
	if jq "$@" "$filter" "$SHOP" > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
		mv "$tmp" "$SHOP"
		return 0
	fi
	rm -f "$tmp"
	printf '%s\n' "  ${BAD}$(m nosave)${D}"
	return 1
}

pause() { local _k; rl $'\n'"  ${RDIM}$(m cont)${RD}" _k || true; }

# The one thing in here that cannot be typed over again. Every other edit is
# a value you can come back and change; a delete leaves nothing to change.
# And what gets typed is `d2`, not the plan — a digit off is a different plan
# gone. So this prints the line d2 stands for and then asks about that line,
# which is the question the seller actually has. Enter is yes: by the time it
# is asked the answer is on screen, directly above the cursor.
confirm() {
	local k
	# Nothing to show is nothing to delete.
	[ -n "$1" ] || return 1
	say ""
	printf '  %s%s%s\n' "$WARN" "$(m del_q)" "$D"
	printf '    %s\n' "$1"
	say ""
	dim "  $(m del_yn)"
	rl "  > " k || return 1
	case "$k" in ""|y|Y|yes|YES) return 0 ;; esac
	say "  ${DIM}$(m kept)${D}"; sleep 1
	return 1
}

# A value that is nothing but @-keys is the wording the page ships with, in
# four languages. Printing `@v_hours` at a seller invites them to "fix" it
# into one language, which is exactly the thing the key was doing for them.
dflt() {
	case "$1" in
		"")  printf '%s' "${DIM}—${D}" ;;
		# A doubled @ is a literal one — a Telegram handle, not a key. That
		# distinction is the file's, and getting it backwards here would tell
		# a seller their own contact details were "the default wording".
		@@*) printf '%s' "$1" ;;
		@*)  printf '%s' "${DIM}$(m dflt_text)${D}" ;;
		*)   printf '%s' "$1" ;;
	esac
}

# ── what state are we in ──────────────────────────────────────────────

published_url() { [ -s "$CREDS" ] && jq -r '.url // ""' "$CREDS" 2>/dev/null; }

benchmark_running() {
	[ -s "$CREDS" ] && return 1
	pgrep -f 'nq-shop (run|collect)' >/dev/null 2>&1
}

publish_running() {
	[ -s "$STATE" ] || return 1
	grep -q '^status=running$' "$STATE"
}

# `nq-shop status` says the same thing in English for a person at a command
# line. This is the screen a seller lands on without asking for it, so it
# reads the same file and says it in the page's own language.
#
# The percentage is of the *expected* work. A search for 22 leading zero bits
# has no progress — only 2^22 tries' worth of expectation — so it is capped at
# 99 and never claims to be nearly done when it might be about to finish or
# might take another minute.
pub_line() {
	[ -s "$STATE" ] || return 1
	local status='' phase='' bits=22 started=0 url='' why='' tries=0 pct=0 age=''
	while IFS='=' read -r k v; do
		case "$k" in
			status) status="$v" ;; phase) phase="$v" ;; bits) bits="$v" ;;
			started) started="$v" ;; url) url="$v" ;; why) why="$v" ;;
		esac
	done < "$STATE"
	[ "$started" -gt 0 ] 2>/dev/null && age=" · $(( $(date +%s) - started )) $(m s_ago)"
	case "$status" in
	running)
		case "$phase" in
			challenge) printf '%s%s%s%s' "$WARN" "$(m s_getting)" "$D" "$age" ;;
			posting)   printf '%s%s%s%s' "$WARN" "$(m s_posting)" "$D" "$age" ;;
			pow)
				if [ -s "$POWLOG" ]; then
					tries="$(sed -n 's/^tries \([0-9]*\)$/\1/p' "$POWLOG" | tail -1)"
					tries="${tries:-0}"
					pct=$(( 100 * tries / (1 << bits) ))
					[ "$pct" -gt 99 ] && pct=99
				fi
				printf '%s%s %s%%%s (%s %s %s)%s' "$WARN" "$(m s_pow)" "$pct" "$D" \
					"$(m s_tried)" "$tries" "$(m s_tries)" "$age" ;;
			*) printf '%s%s%s%s' "$WARN" "$(m s_pow)" "$D" "$age" ;;
		esac ;;
	done)   printf '%s%s%s' "$OK" "$(m s_done)" "$D" ;;
	failed) printf '%s%s%s · %s' "$BAD" "$(m s_failed)" "$D" "$why" ;;
	*)      return 1 ;;
	esac
}

# ── screens ──────────────────────────────────────────────────────────────

screen_benchmarking() {
	clear
	head2 "$(m hdr_bench)"
	say ""
	say "  $(m bench1)"
	say "  $(m bench2)"
	say ""
	if [ -s "$BOOTLOG" ]; then
		head2 "$(m bench_at)"
		sed 's/\x1b\[[0-9;]*m//g' "$BOOTLOG" | grep -v '^$' | tail -4 | sed 's/^/    /'
	fi
	say ""
	dim "  $(m k_refresh)    $(m k_log)    $(m k_shell)    $(m k_quit)"
	local k; rl "  > " k || k=q
	case "$k" in
		l) clear; sed 's/\x1b\[[0-9;]*m//g' "$BOOTLOG" | tail -60; pause ;;
		s) drop_to_shell ;;
		q) exit 0 ;;
	esac
}

screen_publishing() {
	clear
	head2 "$(m hdr_pub)"
	say ""
	say "  $(m pub1)"
	say "  $(m pub2)"
	say ""
	printf '    %s\n' "$(pub_line)"
	say ""
	dim "  $(m k_refresh)    $(m k_shell)    $(m k_quit_pub)"
	local k; rl "  > " k || k=q
	case "$k" in
		s) drop_to_shell ;;
		q) exit 0 ;;
	esac
}

overview() {
	local url; url="$(published_url)"
	clear
	head2 "$(m hdr)"
	say ""
	if [ -n "$url" ]; then
		printf '  %s%s%s   %s%s%s\n' "$DIM" "$(m f_page)" "$D" "$ACC" "$url" "$D"
		printf '  %s%s%s   %s?lang=zh · en · fr · de%s\n' "$DIM" "$(m f_lang)" "$D" "$DIM" "$D"
	else
		printf '  %s%s%s   %s%s%s\n' "$DIM" "$(m f_page)" "$D" "$WARN" "$(m unpub)" "$D"
	fi
	local st; st="$(pub_line || true)"
	[ -n "$st" ] && printf '  %s%s%s   %s\n' "$DIM" "$(m f_state)" "$D" "$st"

	# Every label is padded to one width by hand, in both languages. printf's
	# %-14s pads by bytes and a CJK character is three of them, so a column
	# built that way comes out ragged on exactly the screen this is for.
	head2 "$(m editable)"
	local a b; read -r a b <<<"$(first)"
	printf '   1  %s   %s\n' "$(m i_title)"   "$(dflt "$(q ".shop.title.$a // .shop.title.$b // .shop.title")")"
	printf '   2  %s   %s\n' "$(m i_tags)"    "$(dflt "$(jq -r '[.shop.tags[]?] | join(" · ")' "$SHOP" 2>/dev/null)")"
	printf '   3  %s   %s\n' "$(m i_plans)"   "$(jq -r "[.shop.plans[]? | ((.name.$a // .name.$b // .name)|tostring) + \" \" + (.currency // \"\") + ((.monthly // \"?\")|tostring)] | join(\" · \")" "$SHOP" 2>/dev/null)"
	printf '   4  %s   %s\n' "$(m i_contact)" "$(dflt "$(jq -r '[.shop.contacts[]? | .v] | join(" · ")' "$SHOP" 2>/dev/null)" | sed 's/@@/@/g')"
	printf '   5  %s   %s\n' "$(m i_hours)"   "$(dflt "$(jq -r '[.shop.hours[]? | .v] | join(" · ")' "$SHOP" 2>/dev/null)")"
	printf '   6  %s   %s\n' "$(m i_notes)"   "$(dflt "$(jq -r '[.shop.notes[]?] | join(" / ")' "$SHOP" 2>/dev/null)")"
	printf '   7  %s   %s\n' "$(m i_lang)"    "$L"

	head2 "$(m actions)"
	say "   p  $(m a_pub)${DIM}$(m a_pub_n)${D}"
	say "   b  $(m a_bench)${DIM}$(m a_bench_n)${D}"
	say "   s  $(m a_shell)"
	say "   q  $(m a_quit)"
	say ""
	dim "  $(m tip1)"
	dim "  $(m tip2)"
	say ""
}

# ── the editors ──────────────────────────────────────────────────────────
#
# Four languages come off one answer: zh and en are asked for, fr and de fall
# back to en and then to zh in the renderer. Asking a seller in Shenzhen to
# write German is how a page ends up with the key printed on it instead.

edit_title() {
	clear; head2 "$(m e_title)"
	say ""
	dim "  $(m keep_rule)"
	say ""
	local zh en
	zh="$(ask "$(m q_zh)" "$(q '.shop.title.zh')")"
	en="$(ask "$(m q_en)" "$(q '.shop.title.en')")"
	edit '.shop.title = {zh: $zh, en: $en, fr: $en, de: $en}' --arg zh "$zh" --arg en "$en" \
		&& say "" && say "  ${OK}$(m saved)${D}"
	pause
}

edit_tags() {
	clear; head2 "$(m e_tags)"
	say ""
	dim "  $(m tags_note)"
	say ""
	local cur new
	cur="$(jq -r '[.shop.tags[]?] | join(" ")' "$SHOP")"
	new="$(ask "$(m e_tags)" "$cur")"
	edit '.shop.tags = ($t | split(" ") | map(select(. != "")))' --arg t "$new" \
		&& say "" && say "  ${OK}$(m saved)${D}"
	pause
}

# One plan on two lines: the name, then the prices and the spec rows under
# it. The list draws it and so does the delete confirm, which is the point —
# what you are asked about is the line you were looking at.
plan_line() {
	local a b; read -r a b <<<"$(first)"
	jq -r ".shop.plans[$1] // empty |
		\"\((.name.$a // .name.$b // .name)|tostring)
        \(.currency // \"\")\(.monthly // \"?\") / mo   \(.currency // \"\")\(.yearly // \"?\") / yr   \([.rows[]? | \"\(.k) \(.v)\"] | join(\"  ·  \"))\"" \
		"$SHOP" 2>/dev/null
}

edit_plans() {
	while :; do
		clear; head2 "$(m e_plans)"
		say ""
		local n; n="$(jq '[.shop.plans[]?] | length' "$SHOP")"
		if [ "$n" -eq 0 ]; then
			say "  ${DIM}$(m no_plans)${D}"
		else
			local j=0
			while [ "$j" -lt "$n" ]; do
				printf '   %s  %s\n' "$((j+1))" "$(plan_line "$j")"
				j=$((j+1))
			done
		fi
		say ""
		dim "  $(m list_keys)"
		local k i; rl "  > " k || return
		case "$k" in
			"") return ;;
			a) plan_add ;;
			d*) i="$(idx "${k#d}" "$n")" || continue
			    confirm "$(plan_line "$i")" || continue
			    edit "del(.shop.plans[$i])" && say "  ${OK}$(m deleted)${D}" && sleep 1 ;;
			*)  i="$(idx "$k" "$n")" || continue
			    plan_edit "$i" ;;
		esac
	done
}

plan_add() {
	edit '.shop.plans += [{name: {zh: "新套餐", en: "New plan"}, currency: "¥",
	                       monthly: 0, yearly: 0, rows: []}]' \
		&& plan_edit "$(( $(jq '[.shop.plans[]?] | length' "$SHOP") - 1 ))"
}

plan_edit() {
	local i="$1"
	[ "$(jq "[.shop.plans[]?] | length" "$SHOP")" -gt "$i" ] || return 0
	clear; head2 "$(m plan_n) $((i+1))"
	say ""
	dim "  $(m plan_note)"
	say ""
	local zh en cur mo yr
	zh="$(ask  "$(m q_pzh)" "$(q ".shop.plans[$i].name.zh // .shop.plans[$i].name")")"
	en="$(ask  "$(m q_pen)" "$(q ".shop.plans[$i].name.en")")"
	cur="$(ask "$(m q_cur)" "$(q ".shop.plans[$i].currency")")"
	mo="$(ask  "$(m q_mo)"  "$(q ".shop.plans[$i].monthly")")"
	yr="$(ask  "$(m q_yr)"  "$(q ".shop.plans[$i].yearly")")"

	# tonumber? rather than tonumber: a price typed with a currency sign in
	# it must not take the whole file down, and 0 is a legible wrong answer.
	edit ".shop.plans[$i] |= (.name = {zh: \$zh, en: \$en, fr: \$en, de: \$en}
	       | .currency = \$cur
	       | .monthly = (\$mo | tonumber? // 0)
	       | .yearly  = (\$yr | tonumber? // 0))" \
		--arg zh "$zh" --arg en "$en" --arg cur "$cur" --arg mo "$mo" --arg yr "$yr" \
		|| { pause; return; }

	say ""
	say "  ${OK}$(m saved)${D}"
	local k; rl $'\n'"  $(m rows_ask)${RDIM}$(m rows_hint)${RD} " k || k=""
	[ "$k" = "y" ] && plan_rows "$i"
}

# The rows under a plan: CPU / memory / traffic and so on. `k` may be a key
# like @k_ram, which the page turns into 内存 · Memory · Mémoire · Speicher on
# its own, so the common ones are offered by name and anything else is literal.
plan_rows() {
	local i="$1"
	while :; do
		clear; head2 "$(m plan_n) $((i+1)) $(m e_rows)"
		say ""
		local n; n="$(jq "[.shop.plans[$i].rows[]?] | length" "$SHOP")"
		jq -r ".shop.plans[$i].rows // [] | to_entries[] | \"   \(.key+1)  \(.value.k)  →  \(.value.v)\"" "$SHOP"
		say ""
		dim "  $(m rows_keys)"
		dim "  $(m list_keys)"
		local k j nk nv; rl "  > " k || return
		case "$k" in
			"") return ;;
			a)  nk="$(ask "$(m q_rowk)" "")"
			    nv="$(ask "$(m q_rowv)" "")"
			    edit ".shop.plans[$i].rows += [{k: \$k, v: \$v}]" --arg k "$nk" --arg v "$nv" ;;
			d*) j="$(idx "${k#d}" "$n")" || continue
			    confirm "$(pair ".shop.plans[$i].rows[$j]")" || continue
			    edit ".shop.plans[$i].rows |= del(.[$j])" ;;
			*)  j="$(idx "$k" "$n")" || continue
			    nk="$(ask "$(m q_name)" "$(q ".shop.plans[$i].rows[$j].k")")"
			    nv="$(ask "$(m q_rowv)" "$(q ".shop.plans[$i].rows[$j].v")")"
			    edit ".shop.plans[$i].rows[$j] = {k: \$k, v: \$v}" --arg k "$nk" --arg v "$nv" ;;
		esac
	done
}

# A Telegram handle written @name is read as a lookup key and comes out with
# the sign gone. The doubling is the escape, and nobody should have to know
# that — so it is done here, and undone before the value is shown back.
edit_contacts() {
	while :; do
		clear; head2 "$(m e_contact)"
		say ""
		local n; n="$(jq '[.shop.contacts[]?] | length' "$SHOP")"
		jq -r '.shop.contacts // [] | to_entries[] | "   \(.key+1)  \(.value.k)  →  \(.value.v)"' "$SHOP" \
			| sed 's/@@/@/g'
		say ""
		dim "  $(m con_keys)"
		dim "  $(m list_keys)"
		local k j nk nv; rl "  > " k || return
		case "$k" in
			"") return ;;
			a)  nk="$(ask "$(m q_conk)" "@k_tg")"
			    nv="$(ask "$(m q_conv)" "")"
			    edit '.shop.contacts += [{k: $k, v: $v}]' --arg k "$nk" \
			         --arg v "$(printf '%s' "$nv" | sed 's/^@\([^@]\)/@@\1/')" ;;
			d*) j="$(idx "${k#d}" "$n")" || continue
			    confirm "$(pair ".shop.contacts[$j]" | sed 's/@@/@/g')" || continue
			    edit ".shop.contacts |= del(.[$j])" ;;
			*)  j="$(idx "$k" "$n")" || continue
			    nk="$(ask "$(m q_conk2)" "$(q ".shop.contacts[$j].k")")"
			    nv="$(ask "$(m q_conv)" "$(q ".shop.contacts[$j].v" | sed 's/@@/@/g')")"
			    edit ".shop.contacts[$j] = {k: \$k, v: \$v}" --arg k "$nk" \
			         --arg v "$(printf '%s' "$nv" | sed 's/^@\([^@]\)/@@\1/')" ;;
		esac
	done
}

edit_hours() {
	clear; head2 "$(m e_hours)"
	say ""
	local a b
	a="$(ask "$(m q_hours)" "$(q '.shop.hours[0].v')")"
	b="$(ask "$(m q_deliv)" "$(q '.shop.hours[1].v')")"
	edit '.shop.hours = [{k: "@k_hours", v: $a}, {k: "@k_deliver", v: $b}]' \
		--arg a "$a" --arg b "$b" && say "" && say "  ${OK}$(m saved)${D}"
	pause
}

edit_notes() {
	clear; head2 "$(m e_notes)"
	say ""
	dim "  $(m notes_note)"
	say ""
	local cur new
	cur="$(jq -r '[.shop.notes[]?] | join(" / ")' "$SHOP")"
	new="$(ask "$(m e_notes)" "$cur")"
	edit '.shop.notes = ($n | split(" / ") | map(select(. != "")))' --arg n "$new" \
		&& say "" && say "  ${OK}$(m saved)${D}"
	pause
}

# One answer, two effects: the language the page opens in for a reader who
# states no preference, and the language of this menu. They are the same
# choice and there is no reason to ask twice.
edit_lang() {
	clear; head2 "$(m e_lang)"
	say ""
	dim "  $(m lang_note)"
	say ""
	local new
	new="$(ask "$(m q_lang)" "$L")"
	case "$new" in
		en|zh) edit '.lang = $l' --arg l "$new" && L="$new" && say "" && say "  ${OK}$(m saved)${D}" ;;
	esac
	pause
}

# ── publish, and re-benchmark ────────────────────────────────────────────

do_publish() {
	clear; head2 "$(m e_pub)"
	say ""
	if publish_running; then
		say "  ${WARN}$(m pub_busy)${D}"; pause; return
	fi
	say "  $(m pub_what)"
	say ""
	if ! nq-shop build 2>&1 | sed 's/^/  /'; then
		say "  ${BAD}$(m pub_fail)${D}"; pause; return
	fi
	# setsid, so the publish is not in this session's process group and does
	# not die with the terminal. That is the whole point of it: 22 bits of
	# work is seconds on a fast core and a minute on a slow one, and nobody
	# should have to hold an SSH session open for it.
	setsid nohup env HOME=/root NQ_ENDPOINT="$NQ_ENDPOINT" \
		nq-shop publish >"$PUBLOG" 2>&1 </dev/null &
	sleep 2
	say ""
	say "  ${OK}$(m pub_bg)${D} $(m pub_bg2)"
	pause
}

do_rebench() {
	clear; head2 "$(m e_bench)"
	say ""
	say "  ${WARN}$(m bench_w1)${D}"
	say "  $(m bench_w2)"
	say ""
	printf '  %s %syes%s\n' "$(m bench_conf)" "$B" "$D"
	say ""
	local k; rl "  > " k || k=""
	[ "$k" = "yes" ] || return
	setsid nohup env HOME=/root NQ_ENDPOINT="$NQ_ENDPOINT" \
		nq-shop collect >>"$BOOTLOG" 2>&1 </dev/null &
	say ""
	say "  ${OK}$(m bench_go)${D} $(m bench_go2)"
	pause
}

drop_to_shell() {
	clear
	say "  $(m sh_note) ${DIM}$(m sh_note2)${D}"
	say ""
	NQ_NO_WIZARD=1 "${SHELL:-/bin/bash}" -i || true
}

# ── main ─────────────────────────────────────────────────────────────────

# shop.json is written by `nq-shop init` on the first run. A wizard that comes
# up before it exists — a container reinstalled onto this image with the
# benchmark not yet at that line — writes it rather than showing an empty menu.
[ -s "$SHOP" ] || nq-shop init >/dev/null 2>&1 || true
lang_load

while :; do
	if benchmark_running; then screen_benchmarking; continue; fi
	if publish_running;   then screen_publishing;  continue; fi
	if [ ! -s "$SHOP" ];  then
		clear; head2 "$(m nothing)"
		say ""
		say "  $(m nothing1)"
		say "  ${DIM}nq-shop run --endpoint $NQ_ENDPOINT${D} $(m nothing2)"
		pause; exit 0
	fi

	overview
	rl "  > " choice || exit 0
	case "$choice" in
		1) edit_title ;;
		2) edit_tags ;;
		3) edit_plans ;;
		4) edit_contacts ;;
		5) edit_hours ;;
		6) edit_notes ;;
		7) edit_lang ;;
		p|P) do_publish ;;
		b|B) do_rebench ;;
		s|S) drop_to_shell ;;
		q|Q) clear; exit 0 ;;
	esac
done
