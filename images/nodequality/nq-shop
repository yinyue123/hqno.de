#!/bin/bash
# nq-shop — benchmark this machine and publish it as a sales page.
#
#   nq-shop run          collect, build and publish  (the default)
#   nq-shop init         write the editable price list and stop
#   nq-shop collect      run the checks into raw/
#   nq-shop route        trace the nine backhaul routes into raw/route.json
#   nq-shop build        fold raw/ and shop.json into page.json
#   nq-shop publish      pay the proof of work and post page.json
#   nq-shop show         print the path of every file it keeps
#
# Everything it keeps lives under $NQ_HOME (default /data/nodequality), which
# on an hqnode container is the directory a reinstall does not erase:
#
#   shop.json         yours — prices, contacts, what the machine is called
#   raw/*.json        the checks, exactly as they were written
#   page.json         the two folded together; this is what gets published
#   credentials.json  the id and the token that let you publish over it again
#
# Two things worth knowing before running it. It takes twenty to fifty minutes
# and moves a few GB of speedtest traffic — `--skip net` if that matters. And
# it needs CAP_NET_RAW: podman drops that capability by default, nexttrace and
# mtr both want a raw socket, and without one the nine backhaul routes come
# back as NoData without anything exiting non-zero.
#
#   podman run --rm --cap-add=NET_RAW -v nq:/data … run --endpoint …

set -euo pipefail

NQ_HOME="${NQ_HOME:-/data/nodequality}"
NQ_ENDPOINT="${NQ_ENDPOINT:-}"
NQ_LANG="${NQ_LANG:-en}"
NQ_SHARE="${NQ_SHARE:-/usr/share/nodequality}"

IP_URL="${NQ_IP_URL:-https://IP.Check.Place}"
NET_URL="${NQ_NET_URL:-https://Net.Check.Place}"
HW_URL="${NQ_HW_URL:-https://Hardware.Check.Place}"

SKIP=""
GEEKBENCH=1
DRY_RUN=0
POW_LIMIT="${NQ_POW_LIMIT:-600}"
CHECK_TIMEOUT="${NQ_CHECK_TIMEOUT:-1800}"
# One trace is well under a minute; the pause between them is what keeps nine
# of them inside the API's per-address budget.
ROUTE_TIMEOUT="${NQ_ROUTE_TIMEOUT:-90}"
ROUTE_PAUSE="${NQ_ROUTE_PAUSE:-12}"
ROUTE_RETRIES="${NQ_ROUTE_RETRIES:-4}"
LOW_DATA=0

say()  { printf '\033[1;36m%s\033[0m\n' "$*" >&2; }
warn() { printf '\033[1;33m%s\033[0m\n' "$*" >&2; }
die()  { printf '\033[1;31m%s\033[0m\n' "$*" >&2; exit 1; }

usage() {
	sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
	exit "${1:-0}"
}

skipping() { [[ ",$SKIP," == *",$1,"* ]]; }

# ---------------------------------------------------------------- arguments

CMD=""
while [[ $# -gt 0 ]]; do
	case "$1" in
	run|init|collect|route|build|publish|show) CMD="$1"; shift ;;
	--endpoint)   NQ_ENDPOINT="$2"; shift 2 ;;
	--home)       NQ_HOME="$2"; shift 2 ;;
	--lang)       NQ_LANG="$2"; shift 2 ;;
	--skip)       SKIP="$2"; shift 2 ;;
	--low-data)   LOW_DATA=1; shift ;;
	--no-geekbench) GEEKBENCH=0; shift ;;
	--dry-run)    DRY_RUN=1; shift ;;
	--timeout)    CHECK_TIMEOUT="$2"; shift 2 ;;
	-h|--help)    usage ;;
	*)            die "unknown argument: $1  (try --help)" ;;
	esac
done
CMD="${CMD:-run}"

RAW="$NQ_HOME/raw"
SHOP="$NQ_HOME/shop.json"
PAGE="$NQ_HOME/page.json"
CREDS="$NQ_HOME/credentials.json"

# ---------------------------------------------------------------------- init

cmd_init() {
	mkdir -p "$RAW"
	if [[ -f "$SHOP" ]]; then
		say "$SHOP already exists — leaving it alone"
	else
		cp "$NQ_SHARE/page.default.json" "$SHOP"
		say "wrote $SHOP — edit the prices and contacts in it before publishing"
	fi
}

# ------------------------------------------------------------------- collect

# Each check is asked for JSON with -o, and -o refuses a file that already
# exists, so the old answer goes first. -p is privacy mode, and it does two
# unrelated things: it stops the script posting a copy of its report to a
# paste site that is not ours, and it skips Geekbench — the gate is on the
# call site (`mode_privacy -eq 0 && test_cpu_gb5`), not on whether the binary
# is installed, so shipping Geekbench in the image is not enough on its own.
#
# So -p is kept on every check but the hardware one. That is the trade stated
# plainly: a hardware report goes to Report.Check.Place, and it says what this
# page is about to publish anyway — CPU, memory, disk. The IP report, which
# carries the address, the risk scores and the blacklist standing, keeps -p
# and stays unpublished. `--no-geekbench` puts -p back on all four.
run_check() {
	local name="$1" out="$2"; shift 2
	if skipping "$name"; then
		warn "skipping the $name check"
		return 0
	fi
	say "running the $name check — this is the slow part"
	rm -f "$out"
	if ! timeout "$CHECK_TIMEOUT" bash "$RAW/$name.sh" "$@" -o "$out" >"$RAW/$name.log" 2>&1; then
		warn "the $name check exited non-zero; keeping whatever it wrote"
	fi
	if [[ ! -s "$out" ]]; then
		warn "the $name check produced no JSON — see $RAW/$name.log"
		return 1
	fi
	return 0
}

fetch() {
	curl -fsSL --retry 3 --retry-delay 2 -o "$2" "$1" || die "could not fetch $1"
}

cmd_collect() {
	mkdir -p "$RAW"
	local lang=(); [[ "$NQ_LANG" == "en" ]] && lang=(-E)

	say "fetching the checks"
	fetch "$IP_URL" "$RAW/ip.sh"
	fetch "$HW_URL" "$RAW/hw.sh"
	fetch "$NET_URL" "$RAW/net.sh"
	cp "$RAW/net.sh" "$RAW/trace.sh"

	local low=(); [[ $LOW_DATA -eq 1 ]] && low=(-L)
	local hwp=(); [[ $GEEKBENCH -eq 0 ]] && hwp=(-p)

	run_check ip    "$RAW/ip.json"    "${lang[@]}" -p -y                || true
	run_check hw    "$RAW/hw.json"    "${lang[@]}" "${hwp[@]}" -y       || true
	run_check net   "$RAW/net.json"   "${lang[@]}" -p -y "${low[@]}"    || true
	cmd_route

	say "collected: $(cd "$RAW" && ls -1 *.json 2>/dev/null | tr '\n' ' ')"
}

# --------------------------------------------------------------------- route

# The nine backhaul routes, traced here rather than by Net.sh -R.
#
# Net.sh runs these too and writes none of them to its JSON: the route names
# live in bash arrays that reach the terminal and nothing else, so there has
# never been anything to read. It also starts all nine nexttrace processes at
# once, and that is what makes the section unusable rather than merely
# unavailable — the NextTrace API rate limits per source address, nine
# simultaneous requests all lose it, and each line comes back
# "Unknown -> NoData" while the check still exits as if it had worked.
#
# So they are run one at a time here, with a pause between, asking for JSON
# instead of a coloured table. The provider stays LeoMoeAPI because it is the
# only one that tags the Chinese backbone: ipinfo leaves the 59.43.x hops
# with no ASN at all, and those hops are the CN2 that decides whether a route
# is GIA. The answer to the rate limit is patience, not a worse map.

ROUTE_TARGETS=(
	"BJ ct bj-ct" "BJ cu bj-cu" "BJ cm bj-cm"
	"SH ct sh-ct" "SH cu sh-cu" "SH cm sh-cm"
	"GD ct gd-ct" "GD cu gd-cu" "GD cm gd-cm"
)

cmd_route() {
	mkdir -p "$RAW"
	if skipping route; then
		warn "skipping the backhaul routes"
		return 0
	fi
	if ! command -v nexttrace >/dev/null 2>&1; then
		warn "no nexttrace on PATH — the page will have no route sections"
		return 0
	fi

	local log="$RAW/route.log" out="$RAW/route.json"
	: > "$log"
	local parts=() spec city isp host domain raw json try ok done=0

	say "tracing the nine backhaul routes, one at a time"
	for spec in "${ROUTE_TARGETS[@]}"; do
		read -r city isp host <<<"$spec"
		domain="${host}-v4.ip.zstaticcdn.com"
		ok=0
		for ((try = 1; try <= ROUTE_RETRIES; try++)); do
			raw="$(timeout -s SIGKILL "$ROUTE_TIMEOUT" \
				nexttrace -p 80 -q 3 -4 --tcp --psize 1400 --json --no-rdns \
				"$domain" 2>>"$log" || true)"
			json="$(grep -o '{.*}' <<<"$raw" | tail -n1)"
			if [[ -n "$json" ]] && jq -e '.Hops | length > 0' <<<"$json" >/dev/null 2>&1; then
				ok=1
				break
			fi
			printf 'retry %d for %s %s\n' "$try" "$city" "$isp" >> "$log"
			sleep "$ROUTE_PAUSE"
		done
		if [[ $ok -eq 1 ]]; then
			parts+=("$(jq -c -n --arg city "$city" --arg isp "$isp" \
				--argjson trace "$json" \
				'{city: $city, isp: $isp, hops: $trace.Hops}')")
			done=$((done + 1))
			say "  $city $isp"
		else
			warn "  $city $isp — no answer after $ROUTE_RETRIES tries; see $log"
		fi
		sleep "$ROUTE_PAUSE"
	done

	if [[ $done -eq 0 ]]; then
		warn "no route answered — the page will have no route sections"
		rm -f "$out"
		return 0
	fi
	printf '%s\n' "${parts[@]}" | jq -s '.' > "$out"
	say "traced $done of ${#ROUTE_TARGETS[@]} routes into $out"
}

# --------------------------------------------------------------------- build

cmd_build() {
	[[ -f "$SHOP" ]] || cmd_init
	mkdir -p "$RAW"

	local args=()
	local f
	for f in ip hw net route; do
		if [[ -s "$RAW/$f.json" ]] && jq -e . "$RAW/$f.json" >/dev/null 2>&1; then
			args+=(--slurpfile "$f" "$RAW/$f.json")
		else
			args+=(--argjson "$f" '[]')
		fi
	done

	jq -n "${args[@]}" \
		--slurpfile shop "$SHOP" \
		-f "$NQ_SHARE/normalize.jq" > "$PAGE.tmp" || die "building the page failed"

	# Numbers are the one place jq and the worker can disagree about the same
	# document: an operator writing 49.0 gets `49.0` from jq and `49` from the
	# worker, the two hashes differ, and the publish is refused for content
	# nobody changed. Integral floats are collapsed here, once, so the
	# canonical form the proof is bought for is the one that will be stored.
	jq 'def fix: walk(if type == "number" and . == trunc then trunc else . end); fix' \
		"$PAGE.tmp" > "$PAGE" && rm -f "$PAGE.tmp"

	jq -e 'has("shop") and has("report")' "$PAGE" >/dev/null \
		|| die "the built page is missing shop or report"

	say "built $PAGE ($(wc -c < "$PAGE") bytes)"
}

# ------------------------------------------------------------------- publish

# The bytes both sides hash: keys sorted at every level, no whitespace, no
# trailing newline. `jq -S -c` is that form, which is why the worker's
# canonical() sorts keys and emits nothing else.
canonical() { jq -S -c . "$1" | tr -d '\n'; }

cmd_publish() {
	[[ -n "$NQ_ENDPOINT" ]] || die "no endpoint — pass --endpoint https://… or set NQ_ENDPOINT"
	[[ -s "$PAGE" ]] || die "no $PAGE — run 'nq-shop build' first"
	NQ_ENDPOINT="${NQ_ENDPOINT%/}"

	local body hash
	body="$(canonical "$PAGE")"
	hash="$(printf '%s' "$body" | sha256sum | cut -d' ' -f1)"

	say "asking $NQ_ENDPOINT for a challenge"
	local challenge
	challenge="$(curl -fsS --max-time 30 "$NQ_ENDPOINT/api/challenge?h=$hash")" \
		|| die "the endpoint would not issue a challenge"

	local c d
	c="$(jq -r .challenge <<<"$challenge")"
	d="$(jq -r .difficulty <<<"$challenge")"
	[[ "$c" != "null" && "$d" != "null" ]] || die "the endpoint answered: $challenge"

	say "solving $d bits of proof of work"
	local nonce start
	start=$(date +%s)
	nonce="$(nq-pow "$c" "$d" "$POW_LIMIT")" \
		|| die "could not solve $d bits within ${POW_LIMIT}s"
	say "solved in $(( $(date +%s) - start ))s (nonce $nonce)"

	local id="" token=""
	if [[ -s "$CREDS" ]]; then
		id="$(jq -r '.id // ""' "$CREDS")"
		token="$(jq -r '.token // ""' "$CREDS")"
		[[ -n "$id" ]] && say "updating the page published earlier ($id)"
	fi

	local request
	request="$(jq -n \
		--argjson challenge "$challenge" \
		--arg nonce "$nonce" \
		--argjson page "$body" \
		--arg id "$id" --arg token "$token" \
		'{challenge: $challenge, nonce: $nonce, page: $page}
		 + (if $id == "" then {} else {id: $id, token: $token} end)')"

	if [[ $DRY_RUN -eq 1 ]]; then
		say "--dry-run: not posting. The request would have been:"
		jq -c '{nonce, id, page: (.page | keys)}' <<<"$request" >&2
		return 0
	fi

	say "publishing"
	local answer code
	answer="$(curl -sS --max-time 60 -w '\n%{http_code}' -X POST \
		-H 'Content-Type: application/json' \
		--data-binary @- "$NQ_ENDPOINT/api/publish" <<<"$request")" \
		|| die "the endpoint could not be reached"

	code="$(tail -n1 <<<"$answer")"
	answer="$(sed '$d' <<<"$answer")"

	if [[ "$code" != "200" && "$code" != "201" ]]; then
		die "the endpoint refused it ($code): $(jq -r '.error // .' <<<"$answer" 2>/dev/null || echo "$answer")"
	fi

	# The token comes back exactly once, on the run that created the page.
	# Losing it does not lose the page — it loses the ability to replace it.
	if [[ "$(jq -r '.token // ""' <<<"$answer")" != "" ]]; then
		jq '{id, token, url}' <<<"$answer" > "$CREDS"
		chmod 600 "$CREDS"
		say "saved the id and token to $CREDS — back that file up"
	fi

	printf '\n\033[1;32m%s\033[0m\n' "$(jq -r .url <<<"$answer")"
	printf '%s\n' "$(jq -r '"edit it as " + .json_url' <<<"$answer")" >&2
}

# ---------------------------------------------------------------------- show

cmd_show() {
	printf 'home        %s\n' "$NQ_HOME"
	printf 'prices      %s%s\n' "$SHOP" "$([[ -f $SHOP ]] || echo '   (not written yet)')"
	printf 'page        %s%s\n' "$PAGE" "$([[ -f $PAGE ]] || echo '   (not built yet)')"
	printf 'credentials %s%s\n' "$CREDS" "$([[ -f $CREDS ]] || echo '   (not published yet)')"
	printf 'raw         %s\n' "$RAW"
	# `ls` with nothing to list exits 2, pipefail hands that to the pipeline and
	# set -e would end the function here — one line before the only line anyone
	# runs `show` for.
	if [[ -d "$RAW" ]]; then
		ls -1 "$RAW"/*.json 2>/dev/null | sed 's/^/            /' || true
	fi
	if [[ -s "$CREDS" ]]; then
		printf '\npublished as %s\n' "$(jq -r '.url // .id' "$CREDS")"
	fi
	return 0
}

# ----------------------------------------------------------------------- run

# /data is where this is meant to live, and on hqnode it is opt-in: `hqnode
# run` without --data gives a container no /data at all. Falling back silently
# would work and then lose the publish token on the next reinstall, so say it
# once, loudly, and carry on — a page still gets published either way.
if [[ "$NQ_HOME" == /data/* && ! -d /data ]]; then
	warn "there is no /data here, so $NQ_HOME will sit on the container's own"
	warn "filesystem and go away with it — including the token that lets you"
	warn "republish. Give the container a /data (hqnode run --data 1G), or copy"
	warn "$NQ_HOME/credentials.json somewhere it will survive."
fi

mkdir -p "$NQ_HOME"
case "$CMD" in
init)    cmd_init ;;
collect) cmd_collect ;;
route)   cmd_route ;;
build)   cmd_build ;;
publish) cmd_publish ;;
show)    cmd_show ;;
run)
	[[ -n "$NQ_ENDPOINT" ]] || die "no endpoint — pass --endpoint https://… or set NQ_ENDPOINT"
	cmd_init
	cmd_collect
	cmd_build
	cmd_publish
	;;
*) usage 1 ;;
esac
